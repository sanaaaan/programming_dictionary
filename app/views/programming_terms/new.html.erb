<%= form_with model: @programming_term do |form| %>
  <div>
    <%= form.label :term, "用語" %>
    <%= form.text_field :term %>
  </div>

  <div>
    <%= form.label :meaning, "意味" %>
    <%= form.text_area :meaning %>
  </div>

  <div class="actions">
    <%= form.submit "登録する" %>
  </div>

<% end %>
